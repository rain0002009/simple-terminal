# KoKo 部署配置模板
#
# 使用方法：复制本文件为 .env 后填写必填项。
#   - 开发环境：放在仓库根目录（vite dev 与 server.mjs 共用同一份）
#   - 生产环境：放在 server/ 目录或仓库根目录
# 未配置或缺少必填项时，server.mjs 启动会 fail-fast 并列出缺失字段；
# vite dev 启动也会直接报错。

# ===== 连接配置（必填）=====
# JumpServer HTTP API 地址（同时作为前端“部署上游”展示值）
TARGET_HTTP=
# JumpServer WebSocket 地址
TARGET_WS=
# JumpServer 站点 Origin（用于上游 host / origin 请求头与 AK/AS 签名）
TARGET_ORIGIN=
# JumpServer 机构 ID（以 X-JMS-ORG 请求头发送）
ORG_ID=

# 示例：
# TARGET_HTTP=https://jms.example.com
# TARGET_WS=wss://jms.example.com
# TARGET_ORIGIN=https://jms.example.com
# ORG_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ===== 服务端可选配置 =====
# 监听地址与端口
# HOST=0.0.0.0
# PORT=8081
# 上游代理；留空表示不走代理（旧版公司代理默认值已移除）
# UPSTREAM_PROXY=http://127.0.0.1:8080
# 请求体大小上限（字节），默认 1GiB
# BODY_LIMIT=1073741824

# ===== 开发环境可选配置 =====
# vite dev 把 /ai、/obs、/task-log、/logs 代理到这里（默认即本地 server.mjs）
# DEV_SERVER_URL=http://127.0.0.1:8081

# ===== 对象存储（OBS，仅 /obs 上传功能需要）=====
# 端点主机（不含 scheme），必填才能使用 /obs 上传
# OBS_ENDPOINT_HOST=obs.example.com
# OBS_ACCESS_KEY_ID=your-access-key
# OBS_SECRET_ACCESS_KEY=your-secret-key
# 可选细化：
# OBS_SCHEME=https
# OBS_PORT=443
# OBS_UPLOAD_PROXY=
# OBS_CA_FILE=
# OBS_TLS_REJECT_UNAUTHORIZED=false
